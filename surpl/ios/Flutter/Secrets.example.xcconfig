// Copy to Flutter/Secrets.xcconfig (gitignored) — or let ../scripts/ios-setup.sh write it.
// Values are identifiers the app needs at runtime; keep them out of this public repo.
GMS_API_KEY = your-google-maps-ios-key
// REVERSED_CLIENT_ID from GoogleService-Info.plist (needed only for Google Sign-In)
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxx
// GOOGLE_APP_ID with ":" → "-" and an "app-" prefix, e.g. app-1-165451396509-ios-abc123
FIREBASE_ENCODED_APP_ID = app-1-000000000000-ios-0000000000000000
